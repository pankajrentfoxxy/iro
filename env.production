# =============================================================================
# IRO — production environment checklist (Render / Docker hosts)
# =============================================================================
# Copy sections into Render → each Web Service → Environment, or merge into a
# local file that stays OUT of git once you add real secrets.
#
# Shared rule: AES_256_KEY_BASE64 must be identical on main API and admin API.
# JWT_* (mobile) and ADMIN_JWT_* (admin console) must be different secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Main API — service: server (Dockerfile server/Dockerfile, context server/)
# Health: GET /api/health
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=4000

# Render Postgres: add sslmode=require if your provider requires TLS
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/iro_app?schema=public&sslmode=require
DATABASE_URL=postgresql://iro:YLsQMqCs6j069KaZnXHY7VrkG4Unxzhq@dpg-d81bbenlk1mc73a98p0g-a/iro

# redis:// or rediss:// when TLS
REDIS_URL=redis://red-d81bcer7uimc7386og1g:6379

JWT_ACCESS_SECRET=REPLACE_WITH_MIN_32_CHAR_RANDOM_STRING_MOBILE_ACCESS
JWT_REFRESH_SECRET=REPLACE_WITH_MIN_32_CHAR_RANDOM_STRING_MOBILE_REFRESH
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REGISTER_EXPIRES_IN=15m
REFRESH_TTL_SECONDS=604800

# 32-byte key, base64 — MUST match admin API
AES_256_KEY_BASE64=REPLACE_WITH_32_BYTE_KEY_BASE64

OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6

# Comma-separated origins (mobile deep links / web); no spaces after commas
CORS_ORIGIN=https://your-public-client.example.com

# -----------------------------------------------------------------------------
# Admin API — service: iro-admin-service (Dockerfile iro-admin-service/Dockerfile, context repo root iro/)
# Health: GET /health
# -----------------------------------------------------------------------------
# NODE_ENV=production
# PORT=4010

# DATABASE_URL=<same as main API>
# REDIS_URL=<same as main API>

# ADMIN_JWT_ACCESS_SECRET=REPLACE_WITH_MIN_32_CHAR_RANDOM_STRING_ADMIN_ACCESS
# ADMIN_JWT_REFRESH_SECRET=REPLACE_WITH_MIN_32_CHAR_RANDOM_STRING_ADMIN_REFRESH
# ADMIN_JWT_ACCESS_EXPIRES_IN=15m
# ADMIN_JWT_REFRESH_EXPIRES_IN=7d
# ADMIN_REFRESH_TTL_SECONDS=604800

# AES_256_KEY_BASE64=<same as main API>
# CORS_ORIGIN=https://your-admin-web.example.com

# -----------------------------------------------------------------------------
# Admin web (Next.js) — build-time on Render / CI (not read by Docker API images)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_ADMIN_API_URL=https://your-admin-api.onrender.com/api/admin
