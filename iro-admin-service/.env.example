# Admin-only overrides (optional). Shared vars load first from ../server/.env
#
# Required here ONLY if not using ../server/.env:
# ADMIN_JWT_ACCESS_SECRET=min-32-characters-secret-admin-access-xx
# ADMIN_JWT_REFRESH_SECRET=min-32-characters-secret-admin-refresh-xx

PORT=4010
CORS_ORIGIN=http://localhost:3001

# When ../server/.env is missing, uncomment:
# NODE_ENV=development
# DATABASE_URL=postgresql://iro:iro@localhost:5433/iro_app?schema=public
# REDIS_URL=redis://localhost:6380
# AES_256_KEY_BASE64=<same-as-main-api>
