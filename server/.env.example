NODE_ENV=development
PORT=4000

# Postgres URL must match the **running** Postgres user/password/port.
#
# • This repo's `docker-compose.yml` defines user `iro` / password `iro` on host port **5433**:
#   DATABASE_URL=postgresql://iro:iro@localhost:5433/iro_app?schema=public
#
# • If your container was created elsewhere (common: default `postgres` user), inspect it:
#   docker inspect YOUR_CONTAINER_NAME --format "{{.Config.Env}}" | findstr POSTGRES
#   Example: `postgres` / `postgres` on 5433:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5433/iro_app?schema=public
#
# • Local PostgreSQL on port 5432 uses whatever account you created there — not necessarily `iro`.
DATABASE_URL=postgresql://iro:iro@localhost:5433/iro_app?schema=public

# Redis: docker-compose maps host 6380 → container 6379
REDIS_URL=redis://localhost:6380

JWT_ACCESS_SECRET=change-me-access-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars!!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

AES_256_KEY_BASE64=DKVXUM1w3tP9ZXZbSIguHcR8QzH1L4wZcVX0E1/m1gY=
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6

CORS_ORIGIN=http://localhost:3000,http://localhost:8081
