generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HierarchyType {
  COUNTRY
  STATE
  REGION
  DISTRICT
  BLOCK
  BOOTH
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SurveySentiment {
  SUPPORTIVE
  NEUTRAL
  OPPOSITION
}

enum NominationStatus {
  PENDING
  UNDER_REVIEW
  ELECTION_STARTED
  APPROVED
  REJECTED
  PROMOTED
}

enum ElectionAreaType {
  STATE
  DISTRICT
  BLOCK
  BOOTH
}

enum ElectionStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

model Role {
  id          String @id @default(uuid())
  levelCode   String @map("level_code")
  roleName    String @map("role_name")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  users             User[]
  nominationsCurrent RoleNomination[] @relation("NominationCurrentRole")
  nominationsTarget  RoleNomination[] @relation("NominationTargetRole")
  elections         Election[]
  promotionsFrom    RolePromotion[] @relation("PromotionFromRole")
  promotionsTo      RolePromotion[] @relation("PromotionToRole")
  referralInvites   ReferralInvite[]

  @@unique([levelCode])
  @@index([levelCode])
  @@map("roles")
}

model HierarchyLocation {
  id       String @id @default(uuid())
  type     HierarchyType
  name     String
  parentId String? @map("parent_id")
  parent   HierarchyLocation? @relation("HierarchyTree", fields: [parentId], references: [id], onDelete: SetNull)
  children HierarchyLocation[] @relation("HierarchyTree")
  createdAt DateTime @default(now()) @map("created_at")

  usersState    User[] @relation("UserState")
  usersDistrict User[] @relation("UserDistrict")
  usersBlock    User[] @relation("UserBlock")
  usersBooth    User[] @relation("UserBooth")

  electionsState    Election[] @relation("ElectionState")
  electionsDistrict Election[] @relation("ElectionDistrict")
  electionsBlock    Election[] @relation("ElectionBlock")
  electionsBooth    Election[] @relation("ElectionBooth")

  boothDetail BoothDetail?

  @@index([type])
  @@index([parentId])
  @@map("hierarchy_locations")
}

/// Booth worker dashboard data tied to a hierarchy BOOTH row (voters, pulse mood).
model BoothDetail {
  id              String @id @default(uuid())
  boothLocationId String @unique @map("booth_location_id")
  boothLocation   HierarchyLocation @relation(fields: [boothLocationId], references: [id], onDelete: Cascade)

  boothNumber      String? @map("booth_number")
  registeredVoters Int     @default(900) @map("registered_voters")

  lastMoodSentiment SurveySentiment? @map("last_mood_sentiment")
  lastMoodNote      String?          @map("last_mood_note")
  lastMoodAt        DateTime?        @map("last_mood_at")
  lastMoodByUserId  String?          @map("last_mood_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("booth_details")
}

model User {
  id     String @id @default(uuid())
  fullName String @map("full_name")
  /// AES-256-GCM ciphertext (base64) — includes IV/tag per lib convention
  phoneEncrypted String @map("phone_encrypted")
  /// Deterministic hash for lookup (normalized E.164?); unique
  phoneHash      String @unique @map("phone_hash")
  email     String? @unique
  passwordHash String? @map("password_hash")

  roleId String? @map("role_id")
  role   Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  referralCode String @unique @map("referral_code")
  referredById String? @map("referred_by")
  referredBy   User?   @relation("ReferralTree", fields: [referredById], references: [id], onDelete: SetNull)
  invitees     User[]  @relation("ReferralTree")

  referralInviteUsedId String? @map("referral_invite_used_id")
  referralInviteUsed   ReferralInvite? @relation("UserJoinedViaInvite", fields: [referralInviteUsedId], references: [id], onDelete: SetNull)

  referralInvitesCreated ReferralInvite[] @relation("ReferralInviteCreator")
  leadershipScore Decimal @default(0) @map("leadership_score") @db.Decimal(10, 2)
  peerRatingAvg   Decimal @default(0) @map("peer_rating_avg") @db.Decimal(5, 2)

  totalReferrals   Int @default(0) @map("total_referrals")
  networkSize      Int @default(0) @map("network_size")
  tasksCompleted   Int @default(0) @map("tasks_completed")
  surveysSubmitted Int @default(0) @map("surveys_submitted")
  daysActive       Int @default(0) @map("days_active")

  profileImage String? @map("profile_image")

  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  gender      String?   @map("gender")
  village     String?   @map("village")
  pincode     String?   @map("pincode")
  occupation  String?   @map("occupation")
  education   String?   @map("education")
  /// Free-text labels from registration (kept when hierarchy rows are missing)
  stateLabel    String? @map("state_label")
  districtLabel String? @map("district_label")
  blockLabel    String? @map("block_label")

  stateId    String? @map("state_id")
  districtId String? @map("district_id")
  blockId    String? @map("block_id")
  boothId    String? @map("booth_id")

  state    HierarchyLocation? @relation("UserState", fields: [stateId], references: [id], onDelete: SetNull)
  district HierarchyLocation? @relation("UserDistrict", fields: [districtId], references: [id], onDelete: SetNull)
  block    HierarchyLocation? @relation("UserBlock", fields: [blockId], references: [id], onDelete: SetNull)
  booth    HierarchyLocation? @relation("UserBooth", fields: [boothId], references: [id], onDelete: SetNull)

  status UserStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  referralsOut Referral[] @relation("Referrer")
  referralsIn  Referral[] @relation("Referred")

  tasksAssigned Task[] @relation("TaskAssigner")
  tasksReceived Task[] @relation("TaskAssignee")

  surveys Survey[]

  peerRatingsReceived PeerRating[] @relation("RatedUser")
  peerRatingsGiven    PeerRating[] @relation("RatedByUser")

  leadershipScores LeadershipScore[]

  roleNominations RoleNomination[]

  electionCandidates ElectionCandidate[]
  electionVotesCast  ElectionVote[] @relation("Voter")
  electionVotesFor   ElectionVote[] @relation("CandidateVote")

  electionsCreated Election[]

  rolePromotionsUser     RolePromotion[] @relation("PromotionSubject")
  rolePromotionsPromoter RolePromotion[] @relation("PromotionActor")

  auditLogs AuditLog[]

  questionnaireResponses QuestionnaireResponse[]
  notifications          UserNotification[]
  orgEventsCreated       OrgEvent[]           @relation("OrgEventCreator")
  orgEventRsvps          OrgEventRsvp[]

  @@index([roleId])
  @@index([referredById])
  @@index([stateId, districtId])
  @@map("users")
}

model Referral {
  id             String @id @default(uuid())
  referrerUserId String @map("referrer_user_id")
  referredUserId String @map("referred_user_id")
  levelDepth     Int    @default(1) @map("level_depth")
  createdAt      DateTime @default(now()) @map("created_at")

  referrer User @relation("Referrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referred User @relation("Referred", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@unique([referrerUserId, referredUserId])
  @@index([referrerUserId])
  @@index([referredUserId])
  @@map("referrals")
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  priority    TaskPriority @default(MEDIUM)

  assignedById String? @map("assigned_by")
  assignedToId String? @map("assigned_to")

  status TaskStatus @default(PENDING)

  gpsLat       Decimal? @map("gps_lat") @db.Decimal(12, 7)
  gpsLong      Decimal? @map("gps_long") @db.Decimal(12, 7)
  proofImageUrl String? @map("proof_image_url")
  completedAt  DateTime? @map("completed_at")
  dueDate      DateTime? @map("due_date")

  createdAt DateTime @default(now()) @map("created_at")

  assignedBy User? @relation("TaskAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedTo User? @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([assignedToId, status])
  @@index([assignedToId, dueDate])
  @@index([assignedById])
  @@map("tasks")
}

model Survey {
  id     String @id @default(uuid())
  userId String @map("user_id")
  boothId String? @map("booth_id")

  voterName   String? @map("voter_name")
  voterMobile String? @map("voter_mobile")

  sentiment SurveySentiment?

  gpsLat  Decimal? @map("gps_lat") @db.Decimal(12, 7)
  gpsLong Decimal? @map("gps_long") @db.Decimal(12, 7)

  clientSubmissionId String? @map("client_submission_id")

  submittedAt DateTime @default(now()) @map("submitted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([boothId])
  @@unique([userId, clientSubmissionId])
  @@map("surveys")
}

model PeerRating {
  id            String @id @default(uuid())
  ratedUserId   String @map("rated_user_id")
  ratedByUserId String @map("rated_by_user_id")
  rating        Int
  feedback      String?
  createdAt     DateTime @default(now()) @map("created_at")

  ratedUser   User @relation("RatedUser", fields: [ratedUserId], references: [id], onDelete: Cascade)
  ratedByUser User @relation("RatedByUser", fields: [ratedByUserId], references: [id], onDelete: Cascade)

  @@unique([ratedUserId, ratedByUserId])
  @@index([ratedUserId])
  @@map("peer_ratings")
}

model LeadershipScore {
  id     String @id @default(uuid())
  userId String @map("user_id")

  directReferralScore Decimal @default(0) @map("direct_referral_score") @db.Decimal(10, 2)
  networkScore        Decimal @default(0) @map("network_score") @db.Decimal(10, 2)
  taskScore           Decimal @default(0) @map("task_score") @db.Decimal(10, 2)
  surveyScore         Decimal @default(0) @map("survey_score") @db.Decimal(10, 2)
  activeDaysScore     Decimal @default(0) @map("active_days_score") @db.Decimal(10, 2)
  peerRatingScore     Decimal @default(0) @map("peer_rating_score") @db.Decimal(10, 2)

  finalScore Decimal @default(0) @map("final_score") @db.Decimal(10, 2)

  calculatedAt DateTime @default(now()) @map("calculated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, calculatedAt(sort: Desc)])
  @@map("leadership_scores")
}

model RoleNomination {
  id     String @id @default(uuid())
  userId String @map("user_id")

  currentRoleId   String? @map("current_role_id")
  nominatedRoleId String? @map("nominated_role_id")

  nominationReason String? @map("nomination_reason")
  eligibilityScore Decimal? @map("eligibility_score") @db.Decimal(10, 2)

  status NominationStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at")

  user          User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentRole   Role? @relation("NominationCurrentRole", fields: [currentRoleId], references: [id], onDelete: SetNull)
  nominatedRole Role? @relation("NominationTargetRole", fields: [nominatedRoleId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@map("role_nominations")
}

model Election {
  id    String @id @default(uuid())
  title String

  roleId String? @map("role_id")
  role   Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  areaType ElectionAreaType @map("area_type")

  stateId    String? @map("state_id")
  districtId String? @map("district_id")
  blockId    String? @map("block_id")
  boothId    String? @map("booth_id")

  state    HierarchyLocation? @relation("ElectionState", fields: [stateId], references: [id], onDelete: SetNull)
  district HierarchyLocation? @relation("ElectionDistrict", fields: [districtId], references: [id], onDelete: SetNull)
  block    HierarchyLocation? @relation("ElectionBlock", fields: [blockId], references: [id], onDelete: SetNull)
  booth    HierarchyLocation? @relation("ElectionBooth", fields: [boothId], references: [id], onDelete: SetNull)

  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")

  status ElectionStatus @default(UPCOMING)

  createdById String? @map("created_by")
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  candidates ElectionCandidate[]
  votes      ElectionVote[]

  promotions RolePromotion[]

  @@index([status])
  @@index([stateId, districtId])
  @@map("elections")
}

model ElectionCandidate {
  id         String @id @default(uuid())
  electionId String @map("election_id")
  userId     String @map("user_id")

  statement       String? @map("statement")
  leadershipScore Decimal? @map("leadership_score") @db.Decimal(10, 2)
  totalVotes      Int      @default(0) @map("total_votes")
  finalRank       Int      @default(0) @map("final_rank")

  createdAt DateTime @default(now()) @map("created_at")

  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([electionId, userId])
  @@index([electionId])
  @@map("election_candidates")
}

model ElectionVote {
  id               String @id @default(uuid())
  electionId       String @map("election_id")
  voterUserId      String @map("voter_user_id")
  candidateUserId  String @map("candidate_user_id")

  votedAt DateTime @default(now()) @map("voted_at")

  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  voter    User     @relation("Voter", fields: [voterUserId], references: [id], onDelete: Cascade)
  candidateUser User @relation("CandidateVote", fields: [candidateUserId], references: [id], onDelete: Cascade)

  @@unique([electionId, voterUserId])
  @@index([electionId])
  @@map("election_votes")
}

model RolePromotion {
  id     String @id @default(uuid())
  userId String @map("user_id")

  previousRoleId String? @map("previous_role_id")
  newRoleId      String? @map("new_role_id")

  promotedById String? @map("promoted_by")
  promotionReason String? @map("promotion_reason")

  electionId String? @map("election_id")

  effectiveDate DateTime @default(now()) @map("effective_date")

  user         User     @relation("PromotionSubject", fields: [userId], references: [id], onDelete: Cascade)
  previousRole Role?    @relation("PromotionFromRole", fields: [previousRoleId], references: [id], onDelete: SetNull)
  newRole      Role?    @relation("PromotionToRole", fields: [newRoleId], references: [id], onDelete: SetNull)
  promotedBy   User?    @relation("PromotionActor", fields: [promotedById], references: [id], onDelete: SetNull)
  election     Election? @relation(fields: [electionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("role_promotions")
}

/// Admin / ops audit trail — complements HTTP audit middleware
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  method    String
  path      String
  statusCode Int     @map("status_code")
  ip        String?
  userAgent String? @map("user_agent")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([path])
  @@map("audit_logs")
}

/// Dynamic questionnaires (JSON question definitions) — distinct from pulse `Survey` rows.
model Questionnaire {
  id               String   @id @default(uuid())
  title            String
  type             String   @default("PULSE")
  questions        Json
  targetRoleLevel  String?  @map("target_role_level")
  boothHierarchyId String?  @map("booth_hierarchy_id")
  dueDate          DateTime? @map("due_date")
  xpReward         Int      @default(75) @map("xp_reward")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")

  responses QuestionnaireResponse[]

  @@map("questionnaires")
}

model QuestionnaireResponse {
  id                String   @id @default(uuid())
  questionnaireId   String   @map("questionnaire_id")
  questionnaire     Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers           Json
  gpsLat            Decimal? @map("gps_lat") @db.Decimal(12, 7)
  gpsLong           Decimal? @map("gps_long") @db.Decimal(12, 7)
  submittedAt       DateTime @default(now()) @map("submitted_at")

  @@unique([questionnaireId, userId])
  @@index([userId])
  @@map("questionnaire_responses")
}

model UserNotification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  deepLink  String?  @map("deep_link")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@map("user_notifications")
}

model OrgEvent {
  id             String   @id @default(uuid())
  title          String
  description    String?
  level          String
  jurisdictionId String   @map("jurisdiction_id")
  startsAt       DateTime @map("starts_at")
  endsAt         DateTime? @map("ends_at")
  venueAddress   String   @map("venue_address")
  venueGpsLat    Float?   @map("venue_gps_lat")
  venueGpsLng    Float?   @map("venue_gps_lng")
  bannerUrl      String?  @map("banner_url")
  expectedCount  Int      @default(0) @map("expected_count")
  createdById    String   @map("created_by_id")
  createdBy      User     @relation("OrgEventCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now()) @map("created_at")

  rsvps OrgEventRsvp[]

  @@index([startsAt])
  @@map("org_events")
}

model OrgEventRsvp {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  event     OrgEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rsvpAt    DateTime @default(now()) @map("rsvp_at")
  checkedIn Boolean  @default(false) @map("checked_in")
  checkinAt DateTime? @map("checkin_at")

  @@unique([eventId, userId])
  @@map("org_event_rsvps")
}

/// Hierarchical invite codes (role assigned server-side at registration).
model ReferralInvite {
  id               String   @id @default(cuid())
  code             String   @unique @map("code")

  createdByUserId  String   @map("created_by_user_id")
  createdForRoleId String   @map("created_for_role_id")

  maxUses          Int      @default(1) @map("max_uses")
  usedCount        Int      @default(0) @map("used_count")

  isActive         Boolean  @default(true) @map("is_active")

  expiresAt        DateTime? @map("expires_at")

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  creator          User @relation("ReferralInviteCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  targetRole       Role @relation(fields: [createdForRoleId], references: [id], onDelete: Restrict)

  usersJoined      User[] @relation("UserJoinedViaInvite")

  @@index([createdByUserId])
  @@index([createdForRoleId])
  @@map("referral_invites")
}
